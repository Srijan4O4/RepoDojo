# ==============================================================================
# RepoDojo Environment Variables Template
# Copy this file to .env.development or .env.test. NEVER commit real secrets.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# Client Configuration
VITE_API_URL=http://localhost:5000
VITE_PREVIEW_BASE_URL=http://localhost:8080

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/repodojo_dev

# Redis Configuration (BullMQ Queue)
REDIS_URL=redis://localhost:6379

# JWT Secrets (Generate secure 64-char random strings in production)
JWT_ACCESS_SECRET=dev-insecure-access-secret-change-in-production-1234567890
JWT_REFRESH_SECRET=dev-insecure-refresh-secret-change-in-production-1234567890
JWT_INTERNAL_SERVICE_SECRET=dev-insecure-internal-service-secret-change-in-prod

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Python AI Service
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your-gemini-api-key

# Docker Execution Worker
DOCKER_HOST=
DOCKER_SOCKET_PATH=//./pipe/docker_engine

# Cloudflare R2 Object Storage (S3 Compatible)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=repodojo-artifacts-dev
